# Server Configuration
PORT=3000
NODE_ENV=production

# PostgreSQL Database Configuration (Neon / Vercel Postgres)
# Get your connection string from: https://neon.tech or Vercel Postgres
POSTGRES_URL=postgresql://username:password@host:5432/database_name?sslmode=require
# Alternative variable name (some platforms use this):
# DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_here_change_this_in_production

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_MEDIA_BUCKET_NAME=your_media_bucket_name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@electricalcompany.com
SMTP_TO=business@electricalcompany.com

# Company Information
COMPANY_NAME=Minnah Electricals
COMPANY_PHONE=(555) 123-4567
COMPANY_EMAIL=info@minnahelectricals.com

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPass123!

# SMS Configuration (Choose one provider)
# Options: twilio, arkasel, generic
SMS_PROVIDER=arkasel

# Arkasel SMS Configuration
ARKASEL_API_KEY=your_arkasel_api_key
ARKASEL_SENDER_ID=MinnahElec
SMS_ADMIN_PHONE=+233XXXXXXXXX

# Twilio SMS Configuration (alternative)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Generic HTTP API Configuration (alternative)
# SMS_API_URL=https://your-sms-gateway.com/api/send
# SMS_API_KEY=your_api_key
# SMS_FROM=Minnah Electricals

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Auto-responder Configuration
AUTO_OPEN_HOUR=8
AUTO_CLOSE_HOUR=18
AUTO_TIMEZONE=UTC
AUTO_WEEKENDS_ENABLED=true
